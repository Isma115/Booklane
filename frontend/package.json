{
  "name": "booklane",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc -p tsconfig.e2e.json",
    "lint": "npm run typecheck",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "@angular/material": "22.0.7",
    "@angular/cdk": "22.0.7"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": "11.17.0"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.3"
    }
  }
}
